[Unit]
Description=Kraken Rules Trading Bot (Spot Trading)
After=network.target

[Service]
Type=simple
User=jason

# GPG passphrase is now provided via an age-encrypted file
# (see credentials/key_loader.py for details).
# The old LoadCredentialEncrypted line has been removed.

WorkingDirectory=/home/jason/crypto_trading_bots/kraken_trading_bot

Environment=EXCHANGE=kraken
Environment=KRAKEN_KEYS_PATH=/home/jason/api/kraken/kraken_api_keys.json.gpg

# Age-encrypted GPG passphrase configuration
Environment=TRADING_PASSPHRASE_AGE_FILE=/etc/kraken/trading_passphrase.age
Environment=AGE_IDENTITY_FILE=/home/jason/.age/key.txt

ExecStart=/home/jason/crypto_trading_bots/kraken_trading_bot/start_rules_trading_bot.sh

Restart=on-failure
RestartSec=30
# Bumped from 5s -> 20s so the shutdown sequence (cancel open buys via REST,
# close two ccxt aiohttp sessions, close public + private WebSockets) can
# actually finish before systemd SIGKILLs the process. At 5s, close() races
# the kill and ccxt's "unclosed connector" warning fires every restart.
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kraken_rules_trading_bot

[Install]
WantedBy=multi-user.target
